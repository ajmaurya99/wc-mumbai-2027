{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "WordCamp Mumbai 2027 design tokens. Source of truth is DESIGN-SYSTEM.md (verified against the Site Editor's saved Styles on 27 Sep 2026). W3C DTCG format; fluid spacing presets carry their clamp() expression as a string $value with min/max in $extensions. Every token's $extensions.org.wordcamp.mumbai block records the Twenty Twenty-Five preset slug, CSS variable and class name so components can be built with block pickers instead of CSS.",
  "color": {
    "$type": "color",
    "base": {
      "$value": "#FFFFFF",
      "$description": "Page ground; cards on tinted (sky wash) sections; text on blue, teal or purple.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "base",
          "cssVar": "--wp--preset--color--base",
          "textClass": "has-base-color",
          "bgClass": "has-base-background-color"
        }
      }
    },
    "contrast": {
      "$value": "#0d1b2a",
      "$description": "Body text, headings, link text at rest.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "contrast",
          "cssVar": "--wp--preset--color--contrast",
          "textClass": "has-contrast-color",
          "bgClass": "has-contrast-background-color"
        }
      }
    },
    "accent-1": {
      "$value": "#0073aa",
      "$description": "Blue. Primary buttons, link hover underline, active states.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "accent-1",
          "cssVar": "--wp--preset--color--accent-1",
          "textClass": "has-accent-1-color",
          "bgClass": "has-accent-1-background-color"
        }
      }
    },
    "accent-2": {
      "$value": "#006b78",
      "$description": "Teal. Eyebrows, Kalam taglines, secondary accents.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "accent-2",
          "cssVar": "--wp--preset--color--accent-2",
          "textClass": "has-accent-2-color",
          "bgClass": "has-accent-2-background-color"
        }
      }
    },
    "accent-3": {
      "$value": "#6d28d9",
      "$description": "Purple. Button hover, focus rings, small highlights.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "accent-3",
          "cssVar": "--wp--preset--color--accent-3",
          "textClass": "has-accent-3-color",
          "bgClass": "has-accent-3-background-color"
        }
      }
    },
    "accent-4": {
      "$value": "#546776",
      "$description": "Slate. Meta text, captions, icons.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "accent-4",
          "cssVar": "--wp--preset--color--accent-4",
          "textClass": "has-accent-4-color",
          "bgClass": "has-accent-4-background-color"
        }
      }
    },
    "accent-5": {
      "$value": "#f2f7fa",
      "$description": "Sky wash. Alternate section backgrounds, cards on white sections, info pills, tints.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "accent-5",
          "cssVar": "--wp--preset--color--accent-5",
          "textClass": "has-accent-5-color",
          "bgClass": "has-accent-5-background-color"
        }
      }
    },
    "festive": {
      "$description": "Festive accents. Sparingly, for badges and dividers only. Not theme presets: available only through custom CSS or the colour picker's custom field.",
      "marigold": {
        "$value": "#F6A21B",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": null
          }
        }
      },
      "saffron": {
        "$value": "#E0552D",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": null
          }
        }
      },
      "gold": {
        "$value": "#E8B93B",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": null
          }
        }
      }
    }
  },
  "type": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Newsreader",
          "serif"
        ],
        "$description": "Body and headings. Set in Styles → Typography; never override in CSS.",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "newsreader",
            "cssVar": "--wp--preset--font-family--newsreader",
            "class": "has-newsreader-font-family"
          }
        }
      },
      "accent": {
        "$value": [
          "Kalam",
          "cursive"
        ],
        "$description": "One-line flourishes only (section tagline, pull quote) in accent-2. Only the 700 face is installed. Never body text or buttons.",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "kalam",
            "cssVar": "--wp--preset--font-family--kalam",
            "class": "has-kalam-font-family"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "Body, meta, captions."
      },
      "bold": {
        "$value": 700,
        "$description": "Headings, eyebrows, buttons, Kalam."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Typography picker presets. Body default is 17px fluid to 14px on phones and has no preset slug.",
      "small": {
        "$value": "0.875rem",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "small",
            "cssVar": "--wp--preset--font-size--small",
            "class": "has-small-font-size",
            "useFor": "eyebrow, meta, captions"
          }
        }
      },
      "medium": {
        "$value": "1rem",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "medium",
            "cssVar": "--wp--preset--font-size--medium",
            "class": "has-medium-font-size",
            "useFor": "buttons (16px), body-sized UI text"
          }
        }
      },
      "large": {
        "$value": "1.38rem",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "large",
            "cssVar": "--wp--preset--font-size--large",
            "class": "has-large-font-size",
            "useFor": "card title H3, Kalam tagline"
          }
        }
      },
      "x-large": {
        "$value": "1.75rem",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "x-large",
            "cssVar": "--wp--preset--font-size--x-large",
            "class": "has-x-large-font-size",
            "useFor": "section title H2"
          }
        }
      },
      "xx-large": {
        "$value": "2.15rem",
        "$extensions": {
          "org.wordcamp.mumbai": {
            "preset": "xx-large",
            "cssVar": "--wp--preset--font-size--xx-large",
            "class": "has-xx-large-font-size",
            "useFor": "page title H1"
          }
        }
      }
    },
    "lineHeight": {
      "$type": "number",
      "body": {
        "$value": 1.6
      },
      "heading": {
        "$value": 1.2
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "heading": {
        "$value": "-0.01em",
        "$description": "All headings (set in Styles)."
      },
      "eyebrow": {
        "$value": "0.08em",
        "$description": "Uppercase eyebrow paragraphs."
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Twenty Twenty-Five spacing presets as saved. Pick them in the spacing controls; they serialise as var(--wp--preset--spacing--NN).",
    "20": {
      "$value": "10px",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "20",
          "cssVar": "--wp--preset--spacing--20",
          "useFor": "pill vertical padding, tight gaps"
        }
      }
    },
    "30": {
      "$value": "20px",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "30",
          "cssVar": "--wp--preset--spacing--30",
          "useFor": "between cards or list items; pill side padding"
        }
      }
    },
    "40": {
      "$value": "30px",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "40",
          "cssVar": "--wp--preset--spacing--40",
          "useFor": "card padding; section title to content"
        }
      }
    },
    "50": {
      "$value": "clamp(30px, 5vw, 50px)",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "50",
          "cssVar": "--wp--preset--spacing--50",
          "fluid": {
            "min": "30px",
            "max": "50px"
          },
          "useFor": "root side padding"
        }
      }
    },
    "60": {
      "$value": "clamp(30px, 7vw, 70px)",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "60",
          "cssVar": "--wp--preset--spacing--60",
          "fluid": {
            "min": "30px",
            "max": "70px"
          }
        }
      }
    },
    "70": {
      "$value": "clamp(50px, 7vw, 90px)",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "70",
          "cssVar": "--wp--preset--spacing--70",
          "fluid": {
            "min": "50px",
            "max": "90px"
          },
          "useFor": "section padding top and bottom"
        }
      }
    },
    "80": {
      "$value": "clamp(70px, 10vw, 140px)",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "preset": "80",
          "cssVar": "--wp--preset--spacing--80",
          "fluid": {
            "min": "70px",
            "max": "140px"
          }
        }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "content": {
      "$value": "800px",
      "$description": "Content width (constrained layout)."
    },
    "wide": {
      "$value": "1340px",
      "$description": "Wide alignment."
    }
  },
  "radius": {
    "$type": "dimension",
    "chip": {
      "$value": "8px",
      "$description": "Chips."
    },
    "card": {
      "$value": "16px",
      "$description": "Cards and images."
    },
    "pill": {
      "$value": "999px",
      "$description": "Buttons and pills."
    }
  },
  "shadow": {
    "$type": "shadow",
    "cardHover": {
      "$value": {
        "color": "rgba(13, 27, 42, 0.12)",
        "offsetX": "0",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0"
      },
      "$description": "The only shadow. Cards on hover only, never at rest.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "css": "0 12px 32px rgba(13, 27, 42, .12)"
        }
      }
    }
  },
  "border": {
    "$type": "dimension",
    "button": {
      "$value": "2px",
      "$description": "Outline (secondary) button border, accent-1."
    },
    "accent": {
      "$value": "4px",
      "$description": "Fact card left edge, Accent 2."
    }
  },
  "focus": {
    "ring": {
      "$type": "border",
      "$value": {
        "color": "#6d28d9",
        "width": "2px",
        "style": "solid"
      },
      "$description": "Always visible. Pair with outline-offset 3px."
    },
    "offset": {
      "$type": "dimension",
      "$value": "3px"
    }
  },
  "motion": {
    "$description": "Calm. Hover transitions only, on colour, underline and shadow; the hero is the only animated element. Wrap in prefers-reduced-motion: reduce.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms"
      },
      "slow": {
        "$value": "250ms"
      }
    },
    "lift": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Card hover lift (translateY(-4px)). Never on the header."
    }
  },
  "button": {
    "$description": "Set once in Styles → Blocks → Button (theme default is navy and square; override it).",
    "padding": {
      "$type": "dimension",
      "$value": "0.6rem 1.5rem"
    },
    "fontSize": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "gradient": {
    "$type": "gradient",
    "band": {
      "$value": [
        {
          "color": "#0073aa",
          "position": 0
        },
        {
          "color": "#6d28d9",
          "position": 1
        }
      ],
      "$description": "The one gradient: Accent 1 to Accent 3 at 135deg, for the Be part band only.",
      "$extensions": {
        "org.wordcamp.mumbai": {
          "css": "linear-gradient(135deg,#0073aa 0%,#6d28d9 100%)",
          "blockJson": "\"style\":{\"color\":{\"gradient\":\"linear-gradient(135deg,#0073aa 0%,#6d28d9 100%)\"}}"
        }
      }
    }
  },
  "band": {
    "$description": "Section band recipes (see DESIGN-SYSTEM.md §2).",
    "dark": {
      "$type": "string",
      "$value": "contrast / base text / base button with contrast text"
    },
    "gradient": {
      "$type": "string",
      "$value": "gradient.band / base text / base button with accent-3 text + base outline button"
    }
  },
  "asset": {
    "$description": "Decorative artwork, PNG at 2× under design-system/assets/png, served from jsDelivr (see examples/home/README.md).",
    "cdn": {
      "$type": "string",
      "$value": "https://cdn.jsdelivr.net/gh/ajmaurya99/wc-mumbai-2027@main/design-system/assets/png/"
    },
    "separatorIcons": {
      "$type": "string",
      "$value": "sep-marigold, sep-train, sep-vadapav, sep-chai, sep-taxi, sep-gateway (200×96)"
    },
    "factIcons": {
      "$type": "string",
      "$value": "fact-calendar, fact-pin, fact-train, fact-ticket (24×24)"
    },
    "strips": {
      "$type": "string",
      "$value": "strip-train, strip-toran, strip-waves, strip-kolam (240×60, repeat-x)"
    },
    "tiles": {
      "$type": "string",
      "$value": "tile-lattice-light, tile-lattice-blue, tile-waves-light, tile-waves-blue (120×120, repeat)"
    },
    "motifs": {
      "$type": "string",
      "$value": "motif-gateway, motif-palm, motif-train (480×480, corner, no-repeat)"
    }
  }
}